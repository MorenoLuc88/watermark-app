{
  "manifestVersion": 5,
  "id": "com.lucmoreno.signature",
  "name": "LM Signature",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "26.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "lmSignaturePanel",
      "label": { "default": "LM Signature" },
      "minimumSize": { "width": 230, "height": 300 },
      "preferredDockedSize": { "width": 260, "height": 420 }
    }
  ],
  "requiredPermissions": { "localFileSystem": "plugin" }
}
