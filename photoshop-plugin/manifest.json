{
  "manifestVersion": 5,
  "id": "com.lucmoreno.signature",
  "name": "LM Signature",
  "version": "1.1.1",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "lmSignaturePanel",
      "label": {
        "default": "LM Signature"
      },
      "minimumSize": {
        "width": 230,
        "height": 300
      },
      "maximumSize": {
        "width": 600,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 260,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 260,
        "height": 420
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [
            1,
            1.25,
            1.5,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [
            1,
            1.25,
            1.5,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/plugin.png",
      "scale": [
        1,
        1.25,
        1.5,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
