{
  "manifestVersion": 5,
  "id": "com.lucmoreno.signature.spike",
  "name": "LM Signature - ESSAI (jetable)",
  "version": "0.0.1",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "26.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "lmSpikePanel",
      "label": { "default": "LM Essai" },
      "minimumSize": { "width": 250, "height": 400 },
      "preferredDockedSize": { "width": 300, "height": 560 }
    }
  ],
  "requiredPermissions": { "localFileSystem": "plugin", "clipboard": "readAndWrite" }
}
